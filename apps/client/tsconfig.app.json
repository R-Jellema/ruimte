{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "customConditions": ["source"],
    // ADE CORE's sources are checked under these flags and do not pass them yet (basmilius/adecore#76).
    "noImplicitOverride": false,
    "noImplicitReturns": false,
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.app.tsbuildinfo",
    "lib": ["ES2023", "DOM"],
    "types": ["vite/client"],
    "allowArbitraryExtensions": true,
    "resolveJsonModule": true,
    "jsx": "react-jsx",
    "paths": { "@/*": ["./src/*"] }
  },
  "include": ["src"],
  "exclude": ["src/**/*.test.ts", "src/**/*.test.tsx", "src/worker"]
}

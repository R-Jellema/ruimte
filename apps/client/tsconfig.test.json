{
    "extends": "../../tsconfig.base.json",
    "compilerOptions": {
        "customConditions": ["bun", "source"],
        // ADE CORE's sources are checked under these flags and do not pass them yet (basmilius/adecore#76).
        "noImplicitOverride": false,
        "noImplicitReturns": false,
        "resolveJsonModule": true,
        "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.test.tsbuildinfo",
        "lib": ["ES2023", "DOM"],
        "types": ["bun"],
        "jsx": "react-jsx",
        "paths": {
            "@/*": ["./src/*"]
        }
    },
    "include": ["src/**/*.test.ts", "src/**/*.test.tsx", "test-preload.ts", "testing/**/*.ts", "testing/**/*.tsx"]
}

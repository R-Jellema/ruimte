    },
    "The direct connection did not come up within 20 seconds." : {
      "localizations" : {
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De directe verbinding kwam niet binnen 20 seconden tot stand."
          }
        }
      }
    },
    "The file changed while it played." : {
      "localizations" : {
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Het bestand veranderde tijdens het afspelen."
          }
        }
      }
    },
    "This device is not signed in to the machine." : {
      "localizations" : {
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dit apparaat is niet ingelogd bij de machine."
          }
        }
      }
    },
    "The machine did not answer %@ in time." : {
      "localizations" : {
        "nl" : {
          "stringUnit" : {
            "state" : "translated",

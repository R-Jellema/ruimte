{
  "sourceLanguage" : "en",
  "strings" : {
    "A connection request claims to come from the machine but cannot be verified." : {
      "localizations" : {
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Een verbindingsverzoek zegt van de machine te komen, maar is niet te controleren."
          }
        }
      }
    },
    "A connection on the local network claims to come from the machine but cannot be verified." : {
      "localizations" : {
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Een verbinding op het lokale netwerk zegt van de machine te komen, maar is niet te controleren."
          }
        }
      }
    },
    "No network path to the machine." : {
      "localizations" : {
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Geen netwerkpad naar de machine."
          }
        }
      }
    },
    "Could not reach the machine." : {
      "localizations" : {
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kon de machine niet bereiken."
          }
        }
      }
    },
    "Could not verify the connection service. Try again." : {
      "localizations" : {
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kon de verbindingsdienst niet controleren. Probeer het opnieuw."
          }
        }
      }
    },
    "The connection service is limiting this device. Try again later." : {
      "localizations" : {
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De verbindingsdienst beperkt dit apparaat. Probeer het later opnieuw."
          }
        }
      }
    },
    "The broker needs a secure WebSocket URL." : {
      "localizations" : {
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De broker heeft een beveiligde WebSocket-URL nodig."
          }
        }
      }
    },
    "The connection service refused the connection." : {
      "localizations" : {
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De verbindingsdienst weigerde de verbinding."
          }
        }
      }
    },
    "Could not set up the direct connection. Try again." : {
      "localizations" : {
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kon de directe verbinding niet opzetten. Probeer het opnieuw."
          }
        }
      }
    },
    "The direct connection is not open." : {
      "localizations" : {
        "nl" : {
          "stringUnit" : {
            "state" : "translated",

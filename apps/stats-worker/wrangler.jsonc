{
  "$schema": "../pulsar-worker/node_modules/wrangler/config-schema.json",
  "name": "ruimte-stats",
  "main": "src/index.ts",
  "account_id": "5e565cf9fa55b0eae1f8131903da2ca9",
  "compatibility_date": "2026-08-01",
  "workers_dev": false,
  "preview_urls": false,
  "routes": [{ "pattern": "stats.ruimte.app", "custom_domain": true }],
  // The address book's database: the rollups live in its `usage_daily`, and its migrations are in `apps/pulsar-worker/migrations`.
  "d1_databases": [{ "binding": "DB", "database_name": "ruimte-pulsar", "database_id": "dcbaa2c2-a829-4564-b593-eeede567ce04" }],
  "vars": {
    "ACCOUNT_ID": "5e565cf9fa55b0eae1f8131903da2ca9",
    "ACCESS_EMAIL": "basmilius@hotmail.com"
  },
  // The nightly rollup of the last nine days into D1; a day can still arrive eight days late.
  "triggers": { "crons": ["40 2 * * *"] },
  "observability": { "enabled": true }
}
